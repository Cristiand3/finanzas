rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberOf(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/hogares/$(hid)).data.miembros;
    }

    // Perfil de cada usuario: solo lo lee y escribe su dueño.
    match /usuarios/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /hogares/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.miembros;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid];
      // Miembros: pueden editar el hogar; solo el dueño puede transferir la propiedad.
      // No miembros: solo pueden sumarse a sí mismos presentando el código de invitación vigente.
      allow update: if (signedIn() && request.auth.uid in resource.data.miembros
          && (request.resource.data.owner == resource.data.owner || request.auth.uid == resource.data.owner))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'joinWith'])
          && request.resource.data.joinWith == resource.data.invite
          && request.resource.data.miembros.hasAll(resource.data.miembros)
          && request.resource.data.miembros.size() == resource.data.miembros.size() + 1
          && request.auth.uid in request.resource.data.miembros
          && resource.data.miembros.size() < 6);
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      match /{col}/{id} {
        allow read, write: if memberOf(hid);
      }
    }
  }
}
